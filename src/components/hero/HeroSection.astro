---
/**
 * HeroSection.astro
 * ─────────────────────────────────────────────────
 * Clean, pristine white hero layout featuring the
 * custom SVG centerpiece.
 */

import Centerpiece from './Centerpiece.astro';
---

<section id="hero" class="hero-section">
  <Centerpiece />
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background-color: var(--color-bg); /* Pure white background */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
</style>
