---
/**
 * ProjectRow.astro — Showcase Row for Work Page
 * ─────────────────────────────────────────────────────────────
 * Matches Image 1 (Desktop) & Image 2 (Mobile):
 * - Left column: Client metadata, Year, Bold Title, Description with "Read more"
 * - Right column: Multi-card media showcase with rounded corners and smooth hover zoom
 * - Responsive: Stacks vertically with horizontally scrollable cards on mobile
 */
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<article class="project-row" id={`project-${project.id}`}>
  
  <!-- LEFT COLUMN: INFO -->
  <div class="project-info">
    <div class="project-meta-row">
      <span class="project-client">{project.client}</span>
      <span class="project-year">{project.year}</span>
    </div>

    <h2 class="project-title">
      <a href={project.readMoreLink || '#'} class="project-title-link">
        {project.title}
      </a>
    </h2>

    <p class="project-description">
      {project.description}
      {project.readMoreLink && (
        <a href={project.readMoreLink} class="read-more-link">Read more</a>
      )}
    </p>
  </div>

  <!-- RIGHT COLUMN: MEDIA SHOWCASE -->
  <div class="project-media-showcase">
    <div class="media-track">
      {(project.gallery || project.cards).map((card, i) => (
        <a 
          href={project.readMoreLink || '#'} 
          class={`media-card card-index-${i + 1}`}
          aria-label={`${project.title} Showcase Image ${i + 1}`}
        >
          <img 
            src={card.url} 
            alt={card.alt}
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
            class="media-img"
          />
        </a>
      ))}
    </div>
  </div>

</article>

<style>
  .project-row {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 48px;
    align-items: start;
    width: 100%;
  }

  /* ─── LEFT COLUMN: INFO ─── */
  .project-info {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-top: 4px;
  }

  .project-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
    padding-bottom: 4px;
  }

  .project-client {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111111;
  }

  .project-year {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #111111;
  }

  .project-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 40px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 16px 0 20px 0;
    color: #111111;
  }

  .project-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .project-title-link:hover {
    color: #FF4500;
  }

  .project-description {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
    color: #333333;
    margin: 0;
  }

  .read-more-link {
    font-weight: 700;
    color: #111111;
    text-decoration: none;
    margin-left: 6px;
    display: inline;
    transition: color 0.2s ease, text-decoration 0.2s ease;
  }

  .read-more-link:hover {
    color: #FF4500;
    text-decoration: underline;
  }

  /* ─── RIGHT COLUMN: MEDIA SHOWCASE ─── */
  .project-media-showcase {
    width: 100%;
    min-width: 0;
  }

  .media-track {
    display: flex;
    gap: 12px;
    width: 100%;
    height: 320px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 8px;
  }
  .media-track::-webkit-scrollbar {
    display: none;
  }

  .media-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: #080808;
    text-decoration: none;
    display: block;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    
    height: 100%;
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  .media-img {
    height: 100%;
    width: auto;
    display: block;
  }

  /* ─── RESPONSIVE: TABLET & MOBILE (Image 2 Layout) ─── */
  @media (max-width: 1024px) {
    .project-row {
      grid-template-columns: 320px 1fr;
      gap: 32px;
    }

    .project-title {
      font-size: 34px;
    }

    .media-track {
      height: 280px;
      gap: 8px;
    }
  }

  @media (max-width: 860px) {
    .project-row {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .project-info {
      width: 100%;
    }

    .project-title {
      font-size: 32px;
      margin: 12px 0 14px 0;
    }

    .project-description {
      font-size: 14.5px;
      line-height: 1.6;
    }

    /* Mobile horizontally scrollable track */
    .media-track {
      height: 240px;
      gap: 12px;
    }

  }

  @media (max-width: 480px) {
    .project-title {
      font-size: 28px;
    }

    .media-track {
      height: 200px;
    }

  }
</style>
