---
/**
 * Footer.astro — Minimalist High-End Editorial Footer
 * ─────────────────────────────────────────────────────────────
 * Matches the About page design system:
 * - Left: Static RSN 3D-inspired cube logo + Nav Links (HOME, WORK, ABOUT, CONTACT)
 * - Right: Essential Social icons (Instagram, X, LinkedIn, GitHub) + Copyright notice
 * - Typography: Space Grotesk & Inter matching the About page
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<footer class={`rsn-global-footer ${className}`}>
  <div class="footer-container">
    
    <!-- LEFT SIDE: LOGO + MAIN NAVIGATION -->
    <div class="footer-left">
      <a href="/" class="footer-logo" aria-label="RSN Home">
        <img src="https://ik.imagekit.io/nivas25/RSN/logo.png?tr=w-64,h-64" alt="RSN Logo" class="footer-logo-img" />
      </a>

      <nav class="footer-nav" aria-label="Footer Navigation">
        <a href="/" class="footer-nav-link">HOME</a>
        <a href="/work" class="footer-nav-link">WORK</a>
        <a href="/about" class="footer-nav-link active">ABOUT</a>
        <a href="/contact" class="footer-nav-link">CONTACT</a>
      </nav>
    </div>

    <!-- RIGHT SIDE: SOCIALS + COPYRIGHT -->
    <div class="footer-right">
      
      <!-- SOCIAL ICONS -->
      <div class="footer-socials">
        <a href="https://www.instagram.com/nivas.png" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="Instagram">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>

        <a href="https://x.com/_nivas_sai_" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="X (Twitter)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>

        <a href="https://www.linkedin.com/in/nivas25" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="LinkedIn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>

        <a href="https://github.com/nivas25" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="GitHub">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
      </div>

      <!-- COPYRIGHT -->
      <div class="footer-copyright">
        <span>&copy; {new Date().getFullYear()} REDDY SAI NIVAS</span>
      </div>

    </div>

  </div>
</footer>

<style>
  .rsn-global-footer {
    width: 100%;
    background-color: #FFFFFF;
    border-top: 1px solid #ECECEC;
    padding: 24px 0;
    margin-top: 0;
    position: relative;
    z-index: 10;
  }

  .footer-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  /* ─── LEFT: LOGO & NAV ─── */
  .footer-left {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .footer-logo {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-logo:hover {
    transform: scale(1.05);
  }

  .footer-logo-img {
    width: 32px;
    height: auto;
    object-fit: contain;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .footer-nav-link {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: #666666;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .footer-nav-link:hover {
    color: #111111;
    transform: translateY(-1px);
  }

  .footer-nav-link.active {
    color: #111111;
    font-weight: 600;
  }

  /* ─── RIGHT: SOCIALS & COPYRIGHT ─── */
  .footer-right {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #555555;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .social-icon-link:hover {
    color: #FF4500;
    transform: translateY(-2px);
  }

  .footer-copyright {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #777777;
    white-space: nowrap;
  }

  /* ─── RESPONSIVE BREAKPOINTS ─── */
  @media (max-width: 1024px) {
    .footer-container {
      padding: 0 24px;
      gap: 24px;
    }
    
    .footer-left {
      gap: 24px;
    }
    
    .footer-nav {
      gap: 18px;
    }

    .footer-right {
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .rsn-global-footer {
      padding: 24px 0;
    }

    .footer-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
    }

    .footer-left {
      flex-direction: column;
      gap: 16px;
    }

    .footer-nav {
      gap: 18px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .footer-right {
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }

    .footer-socials {
      gap: 18px;
    }
  }
</style>
