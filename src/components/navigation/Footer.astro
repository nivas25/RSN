---
/**
 * Footer.astro — Minimalist High-End Editorial Footer
 * ─────────────────────────────────────────────────────────────
 * Matches the About page design system:
 * - Left: Static RSN 3D-inspired cube logo + Nav Links (HOME, WORK, ABOUT, CONTACT)
 * - Right: Essential Social icons (Instagram, X, LinkedIn, GitHub) + Copyright notice
 * - Typography: Space Grotesk & Inter matching the About page
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<footer class={`rsn-global-footer ${className}`}>
  <div class="footer-container">
    
    <!-- LEFT SIDE: LOGO + MAIN NAVIGATION -->
    <div class="footer-left">
      <a href="/" class="footer-logo" aria-label="RSN Home">
        <img src="https://ik.imagekit.io/nivas25/RSN/logo.png?tr=w-64,h-64" alt="RSN Logo" class="footer-logo-img" />
      </a>

      <nav class="footer-nav" aria-label="Footer Navigation">
        <a href="/" class="footer-nav-link">HOME</a>
        <a href="/work" class="footer-nav-link">WORK</a>
        <a href="/about" class="footer-nav-link active">ABOUT</a>
        <a href="/contact" class="footer-nav-link">CONTACT</a>
      </nav>
    </div>

    <!-- RIGHT SIDE: SOCIALS + COPYRIGHT -->
    <div class="footer-right">
      
      <!-- SOCIAL ICONS -->
      <div class="footer-socials">
        <a href="https://www.instagram.com/nivas.png" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="Instagram">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>

        <a href="https://x.com/_nivas_sai_" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="X (Twitter)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>

        <a href="https://www.linkedin.com/in/nivas25" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="LinkedIn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>

        <a href="https://huggingface.co/nivas25" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="Hugging Face">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.025 1.13c-5.77 0-10.449 4.647-10.449 10.378 0 1.112.178 2.181.503 3.185.064-.222.203-.444.416-.577a.96.96 0 0 1 .524-.15c.293 0 .584.124.84.284.278.173.48.408.71.694.226.282.458.611.684.951v-.014c.017-.324.106-.622.264-.874s.403-.487.762-.543c.3-.047.596.06.787.203s.31.313.4.467c.15.257.212.468.233.542.01.026.653 1.552 1.657 2.54.616.605 1.01 1.223 1.082 1.912.055.537-.096 1.059-.38 1.572.637.121 1.294.187 1.967.187.657 0 1.298-.063 1.921-.178-.287-.517-.44-1.041-.384-1.581.07-.69.465-1.307 1.081-1.913 1.004-.987 1.647-2.513 1.657-2.539.021-.074.083-.285.233-.542.09-.154.208-.323.4-.467a1.08 1.08 0 0 1 .787-.203c.359.056.604.29.762.543s.247.55.265.874v.015c.225-.34.457-.67.683-.952.23-.286.432-.52.71-.694.257-.16.547-.284.84-.285a.97.97 0 0 1 .524.151c.228.143.373.388.43.625l.006.04a10.3 10.3 0 0 0 .534-3.273c0-5.731-4.678-10.378-10.449-10.378M8.327 6.583a1.5 1.5 0 0 1 .713.174 1.487 1.487 0 0 1 .617 2.013c-.183.343-.762-.214-1.102-.094-.38.134-.532.914-.917.71a1.487 1.487 0 0 1 .69-2.803m7.486 0a1.487 1.487 0 0 1 .689 2.803c-.385.204-.536-.576-.916-.71-.34-.12-.92.437-1.103.094a1.487 1.487 0 0 1 .617-2.013 1.5 1.5 0 0 1 .713-.174m-10.68 1.55a.96.96 0 1 1 0 1.921.96.96 0 0 1 0-1.92m13.838 0a.96.96 0 1 1 0 1.92.96.96 0 0 1 0-1.92M8.489 11.458c.588.01 1.965 1.157 3.572 1.164 1.607-.007 2.984-1.155 3.572-1.164.196-.003.305.12.305.454 0 .886-.424 2.328-1.563 3.202-.22-.756-1.396-1.366-1.63-1.32q-.011.001-.02.006l-.044.026-.01.008-.03.024q-.018.017-.035.036l-.032.04a1 1 0 0 0-.058.09l-.014.025q-.049.088-.11.19a1 1 0 0 1-.083.116 1.2 1.2 0 0 1-.173.18q-.035.029-.075.058a1.3 1.3 0 0 1-.251-.243 1 1 0 0 1-.076-.107c-.124-.193-.177-.363-.337-.444-.034-.016-.104-.008-.2.022q-.094.03-.216.087-.06.028-.125.063l-.13.074q-.067.04-.136.086a3 3 0 0 0-.135.096 3 3 0 0 0-.26.219 2 2 0 0 0-.12.121 2 2 0 0 0-.106.128l-.002.002a2 2 0 0 0-.09.132l-.001.001a1.2 1.2 0 0 0-.105.212q-.013.036-.024.073c-1.139-.875-1.563-2.317-1.563-3.203 0-.334.109-.457.305-.454m.836 10.354c.824-1.19.766-2.082-.365-3.194-1.13-1.112-1.789-2.738-1.789-2.738s-.246-.945-.806-.858-.97 1.499.202 2.362c1.173.864-.233 1.45-.685.64-.45-.812-1.683-2.896-2.322-3.295s-1.089-.175-.938.647 2.822 2.813 2.562 3.244-1.176-.506-1.176-.506-2.866-2.567-3.49-1.898.473 1.23 2.037 2.16c-1.564.932-1.686 1.178-1.464 1.53s3.675-2.511 4-1.297c.323 1.214-3.524 1.567-3.287 2.405.238.839 2.71-1.587 3.216-.642.506.946-3.49 2.056-3.522 2.064-1.29.33-4.568 1.028-5.713-.624"></path>
          </svg>
        </a>

        <a href="https://github.com/nivas25" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="GitHub">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
      </div>

      <!-- COPYRIGHT -->
      <div class="footer-copyright">
        <span>&copy; {new Date().getFullYear()} REDDY SAI NIVAS</span>
      </div>

    </div>

  </div>
</footer>

<style>
  .rsn-global-footer {
    width: 100%;
    background-color: #FFFFFF;
    border-top: 1px solid #ECECEC;
    padding: 24px 0;
    margin-top: 0;
    position: relative;
    z-index: 10;
  }

  .footer-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  /* ─── LEFT: LOGO & NAV ─── */
  .footer-left {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .footer-logo {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-logo:hover {
    transform: scale(1.05);
  }

  .footer-logo-img {
    width: 32px;
    height: auto;
    object-fit: contain;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .footer-nav-link {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: #666666;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .footer-nav-link:hover {
    color: #111111;
    transform: translateY(-1px);
  }

  .footer-nav-link.active {
    color: #111111;
    font-weight: 600;
  }

  /* ─── RIGHT: SOCIALS & COPYRIGHT ─── */
  .footer-right {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #555555;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .social-icon-link:hover {
    color: #FF4500;
    transform: translateY(-2px);
  }

  .footer-copyright {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #777777;
    white-space: nowrap;
  }

  /* ─── RESPONSIVE BREAKPOINTS ─── */
  @media (max-width: 1024px) {
    .footer-container {
      padding: 0 24px;
      gap: 24px;
    }
    
    .footer-left {
      gap: 24px;
    }
    
    .footer-nav {
      gap: 18px;
    }

    .footer-right {
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .rsn-global-footer {
      padding: 24px 0;
    }

    .footer-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
    }

    .footer-left {
      flex-direction: column;
      gap: 16px;
    }

    .footer-nav {
      gap: 18px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .footer-right {
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }

    .footer-socials {
      gap: 18px;
    }
  }
</style>
