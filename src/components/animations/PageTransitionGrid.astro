---
/**
 * PageTransitionGrid.astro — PREMIUM GEOMETRIC WIPE
 * ─────────────────────────────────────────────────
 * Replaced the heavy canvas boxes with an ultra-sleek, 
 * zero-lag, GPU-accelerated geometric slide transition.
 * Industry standard for high-end digital agencies.
 */
---

<!-- Premium Dark Overlay -->
<div id="rsn-premium-wipe" class="fixed inset-0 z-[9999] pointer-events-none bg-[#050505] flex items-center justify-center overflow-hidden">
  <div id="rsn-wipe-panel" class="absolute inset-0 bg-[#111111] w-full h-full transform translate-y-full flex items-center justify-center">
    <div id="rsn-wipe-loader" class="opacity-0 flex flex-col items-center gap-4">
      <div class="w-10 h-10 border-2 border-white/10 border-t-white/80 rounded-full animate-spin"></div>
      <span class="font-['Space_Grotesk'] text-white/50 text-[11px] tracking-[0.2em] uppercase">Loading</span>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  // Inject CSS to KILL the native Astro cross-fade freeze during our custom transition
  function disableNativeFreeze() {
    let style = document.getElementById('rsn-fast-transition');
    if (!style) {
      style = document.createElement('style');
      style.id = 'rsn-fast-transition';
      style.textContent = `::view-transition-group(root), ::view-transition-image-pair(root), ::view-transition-new(root), ::view-transition-old(root) { animation-duration: 0s !important; }`;
      document.head.appendChild(style);
    }
  }

  function enableNativeFreeze() {
    const style = document.getElementById('rsn-fast-transition');
    if (style) style.remove();
  }

  let isTransitioning = false;

  document.addEventListener('astro:before-preparation', (event) => {
    const originalLoader = event.loader;
    const panel = document.getElementById('rsn-wipe-panel');
    const container = document.getElementById('rsn-premium-wipe');
    
    event.loader = async function() {
      disableNativeFreeze();
      isTransitioning = true;
      
      if (container) container.style.pointerEvents = 'auto'; // Block clicks
      
      let loaderTimeout: ReturnType<typeof setTimeout>;
      // Animate IN: Sleek Expo slide up
      if (panel) {
        await new Promise((resolve) => {
          gsap.fromTo(panel, 
            { y: '100%' }, 
            { 
              y: '0%', 
              duration: 0.45, 
              ease: 'expo.inOut', 
              onComplete: () => {
                // If network hangs, gracefully show the loading spinner after 200ms delay
                loaderTimeout = setTimeout(() => {
                  const loader = document.getElementById('rsn-wipe-loader');
                  if (loader) gsap.to(loader, { opacity: 1, duration: 0.4 });
                }, 200);
                resolve(null);
              } 
            }
          );
        });
      }
      
      await originalLoader();
      
      // Cleanup loader immediately if the network request resolved
      if (loaderTimeout) clearTimeout(loaderTimeout);
      const loader = document.getElementById('rsn-wipe-loader');
      if (loader) gsap.set(loader, { opacity: 0 });
    };
  });

  document.addEventListener('astro:page-load', () => {
    if (isTransitioning) {
      const panel = document.getElementById('rsn-wipe-panel');
      const container = document.getElementById('rsn-premium-wipe');
      
      // Animate OUT: Continue sliding up to reveal new page
      if (panel) {
        gsap.to(panel, {
          y: '-100%', 
          duration: 0.45, 
          ease: 'expo.inOut',
          onComplete: () => {
            if (container) container.style.pointerEvents = 'none';
            isTransitioning = false;
            enableNativeFreeze();
          }
        });
      }
    }
  });
</script>
