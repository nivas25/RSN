---
import BaseLayout from '../layouts/BaseLayout.astro';
import KineticTopNav from '../components/navigation/KineticTopNav.astro';
import Footer from '../components/navigation/Footer.astro';
---

<BaseLayout>
  <KineticTopNav />

  <main class="about-container">
    
    <!-- SECTION 1: Intro (Visible Immediately) -->
    <section class="intro-section">
      <div class="intro-content">
        
        <div class="image-wrapper">
          <img 
            src="https://ik.imagekit.io/nivas25/RSN/face_ratio_4_3.jpeg" 
            alt="Reddy Sai Nivas" 
            class="profile-image"
          />
        </div>

        <div class="greeting-wrapper">
          <p class="greeting-text">
            Namaste, I'm <br class="mobile-break"><span class="highlight-name">Reddy Sai Nivas.</span>
          </p>
        </div>

      </div>
    </section>

    <!-- SECTION 2: Depth-of-Field Scroll (Next-Level Readability) -->
    <section class="bio-section">
      <div class="bio-container">
        
        <p class="focus-block">
          I create <strong class="keyword">intelligent systems</strong> that are powerful yet simple to use.
        </p>

        <p class="focus-block">
          By combining <strong class="keyword">machine learning</strong> and <strong class="keyword">agentic AI</strong> 
          <br class="desktop-break">with thoughtful <strong class="keyword">frontend design</strong>,
        </p>

        <p class="focus-block">
          I turn advanced technology into intuitive and 
          <br class="desktop-break"><strong class="keyword">enjoyable experiences.</strong>
        </p>

      </div>
    </section>

    <!-- SECTION 3: Experience -->
    <section class="experience-section">
      <div class="experience-container">
        
        <h2 class="section-title">Experience</h2>
        
        <div class="experience-list">
          
          <div class="experience-item">
            <div class="role-header">
              <h3 class="role-title">Research Intern</h3>
              <span class="role-date">June 2025 – July 2025</span>
            </div>
            <div class="role-details">
              <p class="company-name">Centre for Healthcare Engineering and Learning (cHEAL)</p>
              <p class="company-location">PES University, Bengaluru &bull; Onsite</p>
            </div>
          </div>

          <div class="experience-item">
            <div class="role-header">
              <h3 class="role-title">AI &amp; ML Intern</h3>
              <span class="role-date">Jan 2024 – Apr 2024</span>
            </div>
            <div class="role-details">
              <p class="company-name">Airobosoft</p>
              <p class="company-location">Hebbal, Bengaluru &bull; Onsite</p>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- SECTION 4: Education -->
    <section class="experience-section">
      <div class="experience-container">
        
        <h2 class="section-title">Education</h2>
        
        <div class="experience-list">
          
          <div class="experience-item">
            <div class="role-header">
              <h3 class="role-title">P.E.S University</h3>
              <span class="role-date">2024 – 2027</span>
            </div>
            <div class="role-details">
              <p class="company-name">B.Tech in CSE</p>
              <div class="score-badges">
                <span class="role-score">GPA: 8.36</span>
              </div>
            </div>
          </div>

          <div class="experience-item scroll-reveal">
            <div class="role-header">
              <h3 class="role-title">S.J. (Govt.) Polytechnic <span class="light-text"></span></h3>
              <span class="role-date">2021 – 2024</span>
            </div>
            <div class="role-details">
              <p class="company-name">Diploma in CSE</p>
              <div class="score-badges">
                <span class="role-score">GPA: 9.85</span>
                <span class="role-score highlight-badge">D-CET State Rank: 30</span>
              </div>
            </div>
          </div>

          <div class="experience-item scroll-reveal">
            <div class="role-header">
              <h3 class="role-title">Standard English School</h3>
              <span class="role-date">2011 – 2021</span>
            </div>
            <div class="role-details">
              <p class="company-name">SSLC</p>
              <div class="score-badges">
                <span class="role-score">86.88%</span>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- SECTION 5: Technical Expertise -->
    <section class="experience-section">
      <div class="experience-container">
        
        <h2 class="section-title">Technical Expertise</h2>
        
        <div class="skills-index">
          
          <div class="index-row">
            <h3 class="index-category"><span class="index-num">01</span> AI, ML &amp; Data Science</h3>
            <p class="index-skills">Python, PyTorch, TensorFlow, Keras, Scikit-Learn, Pandas, NumPy, Jupyter, Hugging Face, LLMs, Prompt Engineering, Agentic AI</p>
          </div>

          <div class="index-row">
            <h3 class="index-category"><span class="index-num">02</span> Big Data Ecosystem</h3>
            <p class="index-skills">Apache Spark (PySpark), Apache Kafka, Hadoop (HDFS, Hive), HBase, Columnar Databases, Apache ZooKeeper</p>
          </div>

          <div class="index-row">
            <h3 class="index-category"><span class="index-num">03</span> Full-Stack Web</h3>
            <p class="index-skills">React, Next.js, Node.js, Express.js, MongoDB, Astro, Vite, HTML5, CSS3, JS</p>
          </div>

          <div class="index-row">
            <h3 class="index-category"><span class="index-num">04</span> Database Management</h3>
            <p class="index-skills">MySQL, PostgreSQL, Redis, Neo4j</p>
          </div>

          <div class="index-row">
            <h3 class="index-category"><span class="index-num">05</span> DevOps &amp; Infra</h3>
            <p class="index-skills">AWS, Docker, Kubernetes, Jenkins, Git, GitHub</p>
          </div>

          <div class="index-row">
            <h3 class="index-category"><span class="index-num">06</span> System Design</h3>
            <p class="index-skills">Java, StarUML, SOLID Principles, MVC Architecture, Core Design Patterns</p>
          </div>

        </div>

        <div class="resume-cta-wrapper scroll-reveal">
          <a href="https://ik.imagekit.io/nivas25/RSN/Ai_Resume_1.0.pdf" target="_blank" rel="noopener noreferrer" class="next-level-btn">
            <div class="cube-icon">
              <!-- Colors perfectly matching PageTransitionGrid.astro -->
              <div class="cube-cell" style="background: #E3000F"></div>
              <div class="cube-cell" style="background: #1743FF"></div>
              <div class="cube-cell" style="background: #CCFF00"></div>
              <div class="cube-cell" style="background: #00B140"></div>
              <div class="cube-cell" style="background: #FF4F00"></div>
              <div class="cube-cell" style="background: #85B9FF"></div>
              <div class="cube-cell" style="background: #181287"></div>
              <div class="cube-cell" style="background: #7A0010"></div>
              <div class="cube-cell" style="background: #00593B"></div>
            </div>
            <span class="btn-text">VIEW RESUME</span>
          </a>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initAnimations() {
    const navWrapper = document.querySelector('.pure-3d-nav-wrapper') as HTMLElement;
    if (navWrapper) {
      navWrapper.style.visibility = 'visible';
      navWrapper.classList.remove('gsap-hidden');
    }
    window.dispatchEvent(new CustomEvent('rsn:intro-complete'));

    // 1. Initial Load removed - instantly visible on transition

    // 2. Subtle Parallax for the Image (Adds interactive feel on scroll)
    gsap.to('.image-wrapper', {
      yPercent: 15,
      ease: "none",
      scrollTrigger: {
        trigger: ".intro-section",
        start: "top top",
        end: "bottom top",
        scrub: true
      }
    });

    // 3. Focus-Fade Readability Magic
    // Elements blur out when not in the center of the screen, forcing eye focus
    const focusBlocks = document.querySelectorAll('.focus-block, .experience-item, .index-row, .section-title');
    
    focusBlocks.forEach((block) => {
      ScrollTrigger.create({
        trigger: block,
        // Block is "in focus" from 75% down the screen until it hits 25% down the screen
        start: "top 75%",
        end: "bottom 25%",
        toggleClass: "is-focused"
      });
    });
  }

  document.addEventListener('astro:page-load', initAnimations);
  
  document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach(t => t.kill());
  });
</script>

<style>
  .about-container {
    width: 100%;
    background-color: #FFFFFF;
    position: relative;
    z-index: 10;
  }

  /* ─── SECTION 1: INTRO (100VH) ─── */
  .intro-section {
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 100px 20px 40px 20px;
    box-sizing: border-box;
    /* Will-change for smooth parallax */
    will-change: transform;
  }

  .intro-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 80px;
    width: 100%;
    max-width: 900px;
  }

  .image-wrapper {
    width: 100%;
    max-width: 600px;
    display: flex;
    justify-content: center;
    will-change: transform;
  }

  .profile-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: none;
  }

  .greeting-wrapper {
    text-align: center;
  }

  .greeting-text {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 36px;
    font-weight: 300;
    color: #333333;
    letter-spacing: -0.01em;
  }

  .highlight-name {
    font-family: 'Kaushan Script', cursive;
    font-size: 76px; 
    font-weight: 700;
    color: #000000;
    display: inline-block;
    margin-left: 12px;
    transform: translateY(12px);
    line-height: 0.6;
  }

  .mobile-break {
    display: none;
  }

  /* ─── SECTION 2: BIO (SCROLL FOCUS) ─── */
  .bio-section {
    width: 100%;
    padding: 100px 20px 150px 20px; 
    box-sizing: border-box;
  }

  .bio-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    /* Huge gaps so only one block is truly centered at a time */
    gap: 250px; 
    text-align: center;
  }

  /* ─── The Depth-of-Field Readability Technique ─── */
  .focus-block {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 46px; /* Massive size */
    line-height: 1.5;
    color: #111111;
    font-weight: 300;
    letter-spacing: -0.02em;
    
    /* Default out-of-focus state */
    opacity: 0.15;
    transform: scale(0.92);
    filter: blur(4px);
    
    /* Ultra-smooth cinematic transition */
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity, filter;
  }

  .focus-block.is-focused {
    /* In-focus state */
    opacity: 1;
    transform: scale(1);
    filter: blur(0px);
  }

  .keyword {
    font-weight: 600;
    color: #000000;
  }

  .desktop-break {
    display: block;
  }

  /* ─── SECTION 3: RESUME BLOCKS ─── */
  .experience-section {
    width: 100%;
    /* Massive vertical padding to allow the blur focus effect to work properly */
    padding: 150px 20px 30vh 20px; 
    box-sizing: border-box;
    border-top: 1px solid #EEEEEE; 
  }

  .experience-section:last-of-type {
    padding-bottom: 0;
  }

  .experience-container {
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 120px; /* Huge gap so items blur in/out independently */
  }

  /* Shared Depth-of-Field Blur effect */
  .experience-item, .index-row, .section-title {
    opacity: 0.15;
    transform: scale(0.92);
    filter: blur(4px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity, filter;
  }

  .experience-item.is-focused, .index-row.is-focused, .section-title.is-focused {
    opacity: 1;
    transform: scale(1);
    filter: blur(0px);
  }

  .section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 48px;
    font-weight: 600;
    color: #FF4500; 
    margin: 0 0 100px 0; /* Huge margin to separate from content */
    letter-spacing: -0.02em;
    border-bottom: 2px solid #FF4500;
    padding-bottom: 20px;
  }

  .role-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap; /* Allows date to drop down on very small screens */
    gap: 12px;
  }

  .role-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 42px; /* Role is now massive */
    font-weight: 500;
    color: #111111;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .light-text {
    color: #999999;
    font-weight: 400;
  }

  .role-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .company-name {
    font-family: 'Inter', sans-serif;
    font-size: 20px; 
    font-weight: 400;
    color: #555555;
    margin: 0;
  }

  .company-location {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #888888;
    margin: -2px 0 0 0; /* Pulls slightly tighter to company name */
  }

  .score-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .role-score {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #111111;
    background-color: transparent;
    border: 1px solid #CCCCCC;
    padding: 4px 16px;
    border-radius: 100px; /* Perfect pill shape */
    display: inline-block;
  }

  .highlight-badge {
    border-color: #FF4500;
    color: #FF4500; /* Vibrant Orange */
  }

  /* ─── SECTION 5: EXPERTISE ─── */
  .skills-index {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #111111; 
  }

  .index-row {
    display: flex;
    flex-direction: row;
    padding: 40px 0; /* More generous padding */
    border-bottom: 1px solid #EEEEEE;
    gap: 40px;
    align-items: baseline;
  }

  .index-row:hover {
    border-bottom-color: #FF4500;
    transform: translateX(12px) scale(1) !important; /* Force scale on hover if focused */
  }

  .index-row:hover .index-category {
    color: #FF4500;
  }

  .index-row:hover .index-skills {
    color: #111111; /* Text gets sharp and dark on hover */
  }

  /* ─── SECTION 6: RUBIK'S NEXT LEVEL CTA ─── */
  .resume-cta-wrapper {
    padding-top: 60px;
    padding-bottom: 20px;
    width: 100%;
    display: flex;
    justify-content: center; /* Exact center alignment */
  }

  .next-level-btn {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 16px 40px 16px 24px;
    border: 2px solid #111111;
    border-radius: 100px;
    background: #111111;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .next-level-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.2);
  }

  .cube-icon {
    display: grid;
    grid-template-columns: repeat(3, 8px);
    grid-template-rows: repeat(3, 8px);
    gap: 2px;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .next-level-btn:hover .cube-icon {
    transform: rotate(90deg) scale(1.1);
  }

  .cube-cell {
    width: 100%;
    height: 100%;
    border-radius: 1px;
    transition: border-radius 0.4s ease, opacity 0.4s ease;
  }

  .next-level-btn:hover .cube-cell {
    border-radius: 4px; /* Morphs from strict squares to soft circles */
  }
  
  .next-level-btn:hover .cube-cell:nth-child(even) {
    opacity: 0.7; /* Creates a shimmering/mechanical effect */
  }

  .btn-text {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #FFFFFF;
    letter-spacing: 0.1em;
  }

  .index-category {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #111111;
    margin: 0;
    flex: 0 0 300px; /* Left column */
    transition: color 0.3s ease;
  }

  .index-num {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #AAAAAA;
    margin-right: 12px;
    vertical-align: super;
  }

  .index-skills {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #666666;
    line-height: 1.6;
    margin: 0;
    transition: color 0.3s ease;
  }

  .role-date {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #888888;
    margin: 0;
  }

  /* ─── RESPONSIVE (MOBILE OPTIMIZED) ─── */
  @media (max-width: 768px) {
    .intro-section {
      padding: 80px 20px 40px 20px;
    }

    .intro-content {
      gap: 30px;
    }

    .image-wrapper {
      max-width: 100%; 
    }

    .greeting-text {
      font-size: 24px;
      line-height: 1.4;
    }

    .mobile-break {
      display: block;
    }

    .highlight-name {
      font-size: 50px; 
      margin-left: 0;
      margin-top: 10px;
      transform: translateY(0);
      line-height: 1.0;
    }

    .bio-section {
      padding: 60px 20px 100px 20px;
    }

    .bio-container {
      gap: 180px; /* Still very large on mobile to isolate sentences */
    }

    .focus-block {
      font-size: 28px; /* Perfectly readable on mobile */
      line-height: 1.6;
      filter: blur(3px); /* Slightly less blur on mobile screens */
    }
    
    .desktop-break {
      display: none;
    }

    /* Resume Sections Mobile */
    .experience-section {
      padding: 60px 20px;
    }

    .experience-section:last-of-type {
      padding-bottom: 0;
    }

    .section-title {
      font-size: 36px;
      margin-bottom: 40px;
      padding-bottom: 16px;
    }

    .experience-list {
      gap: 50px;
    }

    .index-row {
      flex-direction: column;
      gap: 12px;
      padding: 24px 0;
    }

    .index-row:hover {
      transform: none; /* Disable slide on mobile */
    }

    .index-category {
      flex: none; /* remove fixed width on mobile */
      font-size: 18px;
    }

    .index-num {
      font-size: 11px;
      margin-right: 8px;
    }

    .index-skills {
      font-size: 15px;
    }

    /* Resume CTA Mobile */
    .resume-cta-wrapper {
      padding-top: 40px;
      padding-bottom: 16px;
    }

    .next-level-btn {
      padding: 14px 32px 14px 20px;
    }

    .role-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .role-title {
      font-size: 32px;
    }

    .company-name {
      font-size: 18px;
    }

    .role-date {
      font-size: 15px;
      /* Move date visually below the company on mobile */
      order: 3;
      margin-top: 4px;
    }
  }
</style>
