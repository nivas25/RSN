---
/**
 * index.astro — Root Page
 * ─────────────────────────────────────────────────
 * The single entry page for the RSN portfolio.
 * Composes the intro animation overlay + hero section.
 *
 * PHASE 2 TODO:
 * - Add additional sections below hero (About, Work, Contact)
 * - Add scroll-based animations for below-the-fold content
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import MosaicGrid from '../components/animations/MosaicGrid.astro';
import KineticShift from '../components/animations/KineticShift.astro';
import CurtainReveal from '../components/animations/CurtainReveal.astro';
import MosaicOrchestrator from '../components/animations/MosaicOrchestrator.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import KineticTopNav from '../components/navigation/KineticTopNav.astro';
import FloatingLetters from '../components/interactive/FloatingLetters.astro';
---

<BaseLayout>
  <!-- Layer 1: Hero (sits behind the mosaic) -->
  <HeroSection />

  <!-- Layer 2: Mosaic overlay (covers the hero until animation completes) -->
  <MosaicGrid />

  <!-- Global Kinetic Expanding Navigation -->
  <KineticTopNav />

  <!-- Automated Floating Letters Background -->
  <FloatingLetters />

  <!-- Animation controllers (logic-only, no visual markup) -->
  <KineticShift />
  <CurtainReveal />
  <MosaicOrchestrator />
</BaseLayout>
